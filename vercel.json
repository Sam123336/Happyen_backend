{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/cron/heartbeat.js": {
      "maxDuration": 60
    },
    "api/queues/venue-ingest.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "venue-candidates"
        }
      ]
    },
    "api/cron/ingest-events.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ingest-events",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api"
    }
  ]
}
