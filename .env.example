HAPPYN_ENV=local
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.
DATABASE_URL=postgresql://happyn:happyn@localhost:55432/happyn
HAPPYN_POSTGRES_PORT=55432

# Neon: both endpoints are port 5432 and differ only by `-pooler` in the host.
# DATABASE_URL is the PgBouncer pooler and is what the serverless functions use.
# DIRECT_URL is the direct endpoint, used only by migrations.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Shared secret Vercel Cron sends as a bearer token. Required outside local.
# CRON_SECRET=

SUPABASE_URL=https://your-project.supabase.co

# Foursquare Places, used for venue search. This must be a Service Key from the
# Foursquare developer console; legacy v3 API keys are rejected with 401.
# FOURSQUARE_API_KEY=

# Upstash Redis, caching Foursquare searches so a repeated one costs nothing
# upstream. The Vercel integration injects both on deployed environments; set
# them by hand for a local run. Without both, the cache is simply off.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# How long a cached Foursquare search may be reused, in seconds (default 3600).
# Foursquare's licence caps caching of Places Data by account type: check the
# agreement for this account before raising it.
# PLACES_CACHE_TTL_SECONDS=3600
