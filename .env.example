HAPPYN_ENV=local
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.
DATABASE_URL=postgresql://happyn:happyn@localhost:55432/happyn
HAPPYN_POSTGRES_PORT=55432

# Neon: both endpoints are port 5432 and differ only by `-pooler` in the host.
# DATABASE_URL is the PgBouncer pooler and is what the serverless functions use.
# DIRECT_URL is the direct endpoint, used only by migrations.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Shared secret Vercel Cron sends as a bearer token. Required outside local.
# CRON_SECRET=

SUPABASE_URL=https://your-project.supabase.co

# Foursquare Places, used for venue search. This must be a Service Key from the
# Foursquare developer console; legacy v3 API keys are rejected with 401.
# FOURSQUARE_API_KEY=

# Fast2SMS delivers the Supabase-generated sign-in code. Route "otp" needs no
# DLT registration and no sender id, and only reaches Indian numbers.
# FAST2SMS_API_KEY=


# Pepper for the OTP HMAC. Any long random string; `openssl rand -base64 32`.
# Rotating it invalidates codes in flight, which is harmless.
# OTP_HASH_SECRET=

# Ed25519 keys for sessions Happyen issues itself. Generate with:
#   openssl genpkey -algorithm ed25519 -out key.pem
#   openssl pkey -in key.pem -pubout -out key.pub.pem
#   base64 -i key.pem   # and base64 -i key.pub.pem
# Base64 of the PEM is accepted as well as the PEM, because a PEM's newlines
# do not survive an env file intact. Only the signing deployment needs the
# private half.
# SESSION_JWT_PRIVATE_KEY=
# SESSION_JWT_PUBLIC_KEY=
# Whatever origin actually serves this environment; distinct per
# environment, or a staging token verifies in production.
# SESSION_JWT_ISSUER=http://localhost:3000
# SESSION_JWT_AUDIENCE=happyen-mobile

# Upstash Redis, caching Foursquare searches so a repeated one costs nothing
# upstream. The Vercel integration injects both on deployed environments; set
# them by hand for a local run. Without both, the cache is simply off.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# How long a cached Foursquare search may be reused, in seconds (default 3600).
# Foursquare's licence caps caching of Places Data by account type: check the
# agreement for this account before raising it.
# PLACES_CACHE_TTL_SECONDS=3600

# Vercel Queues needs nothing here. Authentication is OIDC: on Vercel the
# token is injected automatically, and locally `vercel link && vercel env pull`
# writes VERCEL_OIDC_TOKEN into `.env.local`, which the start scripts load when
# it exists. That file is short-lived and gitignored — never add its contents
# here. Note `vercel env pull` writes EVERY project variable, which is why the
# scripts load it FIRST and the intended env file last, so it cannot override
# the database you meant to use.
