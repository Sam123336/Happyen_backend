HAPPYN_ENV=local
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.
DATABASE_URL=postgresql://happyn:happyn@localhost:55432/happyn
HAPPYN_POSTGRES_PORT=55432

# Supabase: DATABASE_URL is the Supavisor transaction pooler (port 6543) and is
# what the serverless functions use. DIRECT_URL is the direct connection
# (port 5432) and is used only by migrations.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Shared secret Vercel Cron sends as a bearer token. Required outside local.
# CRON_SECRET=

FIREBASE_PROJECT_ID=happyn-local

# Foursquare Places, used for venue search. This must be a Service Key from the
# Foursquare developer console; legacy v3 API keys are rejected with 401.
# FOURSQUARE_API_KEY=
